<?xml version="1.0" encoding="utf-8"?>
<!--
  The journal records which files were cleaned and when, which is a list of the
  user's files. It does not leave the device: no cloud backup, no device
  transfer. A privacy tool whose bookkeeping is backed up to a third party has
  given away the thing it was protecting.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
